    "test:e2e": "playwright test",
    "check:assets": "node scripts/check-assets.mjs"
  },
  "dependencies": {
    "gsap": "3.15.1",
    "lenis": "1.3.27",
    "three": "0.187.0",
    "vue": "3.5.45"
  },
  "devDependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "@types/three": "0.187.0",
    "@vitejs/plugin-vue": "6.0.11",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "vue-tsc": "3.3.14"
  }
}
